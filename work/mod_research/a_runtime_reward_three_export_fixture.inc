#include "a_runtime_reward_three_exports.h"
#include "a_save_repeat_exports.h"
extern "C" void ASaveRewardThreeFixtureBind(a_save_local_runtime::Runtime*,const a_save_local_runtime::Config*)noexcept;
namespace ew=a_runtime_reward_wire;namespace pw=a_runtime_reward_planning_wire;namespace sw=a_save_runtime_wire;
template<class T>static void exportEnvelope(T&q,unsigned op){q.header={sw::Magic,sw::Version,sizeof q,op,0};memset(q.nonce,0x37,32);}
static ew::Context exportContext(const checkpoint_planning_hold::Binding&bnd){ew::Context q{};q.pid=GetCurrentProcessId();q.birth=cfg.storage.attachment.birth;memcpy(q.native.attempt,bnd.native.attempt.data(),16);memcpy(q.native.attachment,bnd.native.attachment.data(),16);q.native.ownerGeneration=bnd.native.owner_generation;q.period=bnd.period;q.epoch=bnd.epoch;memcpy(q.inputDigest,bnd.room_input_digest.data(),32);return q;}
template<class T>static void exportEvidence(const char*name,const T&q){static unsigned count=0;char file[128]{};sprintf_s(file,"%s-%02u.bin",name,++count);FILE*f=nullptr;need(!fopen_s(&f,file,"wb")&&f&&fwrite(&q,1,sizeof q,f)==sizeof q&&!fclose(f),"write exported evidence");}
class RewardExportProxy {
public:
 bool ConfigureReward(const a_save_local_runtime::RewardConfig&c){ew::Configure q{};exportEnvelope(q,11);q.context=exportContext(c.binding);for(unsigned i=0;i<2;++i)q.actors[i]={static_cast<unsigned char>(c.actors[i].force),static_cast<unsigned char>(c.actors[i].district),static_cast<unsigned short>(c.actors[i].ruler)};return ASaveRuntimeRewardConfigure(&q)==0;}
 bool OpenPlanning(const a_save_local_runtime::PlanningRequest&p){pw::Open q{};exportEnvelope(q,14);q.context=exportContext(p.binding);q.generation=p.generation;memcpy(q.artifactSha256,p.artifactSha256,32);return ASaveRuntimeOpenPlanning(&q)==0;}
 void PlanningSnapshot(a_save_local_runtime::PlanningReport&p){pw::Snapshot q{};exportEnvelope(q,15);need(!ASaveRuntimePlanningSnapshot(&q),"actual planning Snapshot export");p.state=static_cast<a_save_local_runtime::PlanningState>(q.state);p.error=static_cast<a_save_local_runtime::PlanningError>(q.error);p.opened=q.opened!=0;p.receiptMatched=q.receiptMatched!=0;p.stopped=q.stopped!=0;p.hostThread=q.hostThread;exportEvidence("planning",q);}
 bool SubmitReward(const checkpoint_planning_hold::Binding&bnd,std::uint64_t seq,const a_reward_save_owner::rw::Command&c){ew::Submit q{};exportEnvelope(q,12);q.context=exportContext(bnd);q.sequence=seq;auto&d=q.command;memcpy(d.nonce,c.nonce.data(),32);d.year=c.year;d.month=c.month;d.day=c.day;d.viewer=c.viewer_force;d.actor=c.command_force;d.ruler=c.ruler;d.city=c.funding_city;d.district=c.charged_district;d.count=c.count;memcpy(d.officers,c.officers,sizeof d.officers);d.expiresAtTick=c.expires_at_tick;return ASaveRuntimeRewardSubmit(&q)==0;}
 void RewardSnapshot(a_save_local_runtime::RewardReport&p){ew::Snapshot q{};exportEnvelope(q,13);need(!ASaveRuntimeRewardSnapshot(&q),"actual reward Snapshot export");p.state=static_cast<a_save_local_runtime::RewardState>(q.state);p.readyResealed=q.readyResealed!=0;p.owner.completed=q.completed;need(!q.fullInputHold&&!q.worldFenceProven&&!q.nativeGameplayEnabled,"reward export does not invent gameplay proof");exportEvidence("reward",q);}
 bool RequestNext(const a_save_local_runtime::Next&n){a_save_repeat_wire::Next q{};exportEnvelope(q,9);auto&d=q.request;d.previousGeneration=n.previousGeneration;memcpy(d.previousSha256,n.previousSha256,32);d.generation=n.generation;d.period=n.period;d.epoch=n.epoch;memcpy(d.inputDigest,n.inputDigest,32);d.year=n.year;d.month=n.month;d.day=n.day;return ASaveRuntimeRequestNext(&q)==0;}
 void Stop(){sw::Command q{};exportEnvelope(q,6);need(!ASaveRuntimeStop(&q),"actual Stop export");}
};
